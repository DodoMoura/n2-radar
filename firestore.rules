rules_version = '2';

// N2 Radar — regras do Firestore
// Papéis (coleção usuarios/{uid}): admin, gestor, analista.
// O primeiro acesso dos e-mails em ADMINS cria o próprio perfil de admin;
// os demais pedem acesso e um admin libera em Configurações → Usuários.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function temPerfil() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function perfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ativo() { return temPerfil() && perfil().ativo == true; }
    function papel(lista) { return ativo() && perfil().papel in lista; }
    function adminInicial() {
      return logado() && request.auth.token.email_verified == true
        && request.auth.token.email in ['deoliveiramouraeduardohenrique@gmail.com', 'eduardo.moura@ixcsoft.com.br'];
    }

    match /usuarios/{uid} {
      allow read: if ativo() || (logado() && request.auth.uid == uid);
      allow create: if papel(['admin'])
        || (adminInicial() && request.auth.uid == uid && request.resource.data.papel == 'admin' && request.resource.data.ativo == true);
      allow update, delete: if papel(['admin']);
    }

    match /solicitacoesAcesso/{uid} {
      allow create, update: if logado() && request.auth.uid == uid;
      allow read, delete: if papel(['admin']);
    }

    // Pedidos importados do Baseline. Analistas só alteram a classificação.
    match /pedidos/{id} {
      allow read: if ativo();
      allow create, delete: if papel(['admin', 'gestor']);
      allow update: if papel(['admin', 'gestor'])
        || (ativo() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classificacao']));
    }

    match /tarefas/{id} {
      allow read: if ativo();
      allow create: if ativo() && request.resource.data.criadoPor == request.auth.uid;
      allow update, delete: if papel(['admin', 'gestor']) || (ativo() && resource.data.criadoPor == request.auth.uid);
    }

    match /historico/{id} {
      allow read, create: if ativo();
    }

    match /config/{id} {
      allow read: if ativo();
      allow write: if papel(['admin']);
    }

    match /status/{id} {
      allow read: if ativo();
      allow write: if papel(['admin', 'gestor']);
    }
  }
}
